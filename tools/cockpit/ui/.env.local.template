# Cockpit · variables de entorno
# Copia este archivo a .env.local y completa los valores. TODO opcional —
# el cockpit usa fallbacks razonables si esto no existe.

# Ruta absoluta al workspace raíz del adopter (donde viven project.config.yaml,
# docs/ y los dirs por brand `{slug}/docs/product/`).
# Default: `git rev-parse --show-toplevel` desde el cwd del cockpit.
# Solo overridear si el cockpit corre afuera del repo (raro).
# WORKSPACE_ROOT=/ruta/al/workspace

# Brand por defecto al abrir el cockpit (un slug de brands.active del
# project.config.yaml · single-brand default: main).
# Default: la primera brand detectada.
# DEFAULT_BRAND=main

# Editor binary para "Abrir en editor externo" (botón ↗ secundario en cada
# vista de archivo). El cockpit ahora trae editor inline (react-markdown +
# CodeMirror YAML), así que esto es solo fallback para edición compleja.
#
# Default fallback chain (si no se setea): xdg-open, code, xed, gnome-text-editor, nano
#   - xdg-open delega al editor configurado en tu desktop para .md/.yaml
#   - resto se prueban en orden si xdg-open no está
#
# Override con un solo editor:
#   EDITOR_BIN=code
#
# Override con fallback chain explícito (probar en orden):
#   EDITOR_BIN=code,xed,xdg-open
#
# EDITOR_BIN=xdg-open

# Puerto del dev server (default 4000 · el seam declara brands[].ports.cockpit).
# PORT=4000

# Modo desarrollo: si está activo, expone /api/debug endpoints
NEXT_PUBLIC_DEV_MODE=true
