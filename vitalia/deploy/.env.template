# vitalia/deploy/.env.template
# Vitalia environment variable template.
# Copy to .env and fill in real values BEFORE running locally or deploying.
#
# SECURITY: .env is in .gitignore — NEVER commit real values.
# For K8s production: use secrets.template.yaml + kubectl/Doppler/Vault.
#
# Arch ref: 03-arch.md § 5.3 + § 5.4 + § 5.5 (Chris UI gates Q4=B)

# ── Application ────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── Database (Postgres) ───────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vitalia_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_real_value

# ── Redis (LangGraph RedisSaver checkpointer — D10: cross-brand shared) ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
VITALIA_REDIS_PASSWORD=replace_with_real_value

# ── Qdrant vector store (KB packs: medical_dental / psychology / psychiatry) ─
QDRANT_HOST=localhost
QDRANT_PORT=6333
VITALIA_QDRANT_API_KEY=replace_with_real_value

# ── Clerk app #2 — stand-alone Vitalia (NOT shared with Nicolify per § 5.4) ─
# Chris provisions: dashboard.clerk.com → create app "vitalia"
VITALIA_CLERK_PUBLISHABLE_KEY=replace_with_real_value
VITALIA_CLERK_SECRET_KEY=replace_with_real_value
# Webhook signing secret — Clerk → Webhooks → endpoint /api/v1/vitalia/webhooks/clerk
VITALIA_CLERK_WEBHOOK_SECRET=replace_with_real_value

# ── Stripe Connect (US/EU clinics secondary market) ──────────────────────
# NOTE: NO Stripe Healthcare flag — compliance_level=hipaa_lite (Q6=B ratified).
# Chris provisions: dashboard.stripe.com → Developers → API Keys
VITALIA_STRIPE_SECRET_KEY=replace_with_real_value
# Stripe → Developers → Webhooks → endpoint /api/v1/vitalia/webhooks/stripe
VITALIA_STRIPE_WEBHOOK_SECRET=replace_with_real_value

# ── MercadoPago (LatAm primary — AR/MX/BR/CL/CO) ────────────────────────
# Chris provisions: mercadopago.com/developers → Credentials → Production
# Use TEST credentials for local development (sandbox mode).
VITALIA_MERCADOPAGO_ACCESS_TOKEN=replace_with_real_value
VITALIA_MERCADOPAGO_PUBLIC_KEY=replace_with_real_value
# MercadoPago → Webhooks → endpoint /api/v1/vitalia/webhooks/mercadopago
VITALIA_MERCADOPAGO_WEBHOOK_SECRET=replace_with_real_value

# ── WhatsApp Business API ────────────────────────────────────────────────
VITALIA_WHATSAPP_WEBHOOK_SECRET=replace_with_real_value

# ── ManyChat ─────────────────────────────────────────────────────────────
VITALIA_MANYCHAT_WEBHOOK_SECRET=replace_with_real_value

# ── Consent URL HMAC signing ─────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
VITALIA_CONSENT_URL_SECRET=replace_with_real_value

# ── Anthropic API (agentic surface) ──────────────────────────────────────
ANTHROPIC_API_KEY=replace_with_real_value

# ── Domain (override for local dev) ──────────────────────────────────────
VITALIA_APP_DOMAIN=localhost:8000
VITALIA_CDN_DOMAIN=localhost:8000
VITALIA_API_BASE_URL=http://localhost:8000/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Compliance (hardcoded per Q6=B ratification — DO NOT change) ─────────
VITALIA_COMPLIANCE_LEVEL=hipaa_lite
VITALIA_BRAND_SLUG=vitalia

# ── Feature flags (greenfield Story 11 — no flips per anti-default-flip-audit.md) ─
VITALIA_VOICE_CLONING_ENABLED=false
VITALIA_MULTI_SITE_FEDERATION_ENABLED=false
VITALIA_INSURANCE_INTEGRATION_ENABLED=false
