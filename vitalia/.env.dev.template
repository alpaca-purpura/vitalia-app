# === Clerk (Auth) ===
# Pega valores desde Clerk dashboard → API Keys. Frontend API URL == CLERK_ISSUER.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
# CLERK_ISSUER = Frontend API URL — requerido por core/luana-core-iam/application/auth.py (JWT verify)
CLERK_ISSUER=https://REPLACE_ME.clerk.accounts.dev
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# === Database ===
# Host: usar 127.0.0.1 cuando conectas desde el host
# Container: usar luana_postgres_dev cuando conectas desde otro container
DATABASE_URL=postgresql+asyncpg://postgres:password@127.0.0.1:5435/vitalia_dev

# === Redis (DB 1) ===
REDIS_URL=redis://127.0.0.1:6379/1

# === Qdrant ===
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_COLLECTION_PREFIX=vitalia_

# === Brand ===
BRAND_SLUG=vitalia
ENVIRONMENT=development

# === LLM (via proxy LiteLLM — NUNCA keys de provider aquí) ===
# El backend habla SOLO con el proxy (make litellm-up · scripts/litellm-proxy-up.sh).
# Keys reales de provider (DeepSeek/Moonshot/OpenAI) van en deploy/litellm/.env
# (copiar de deploy/litellm/.env.example).
#
# LITELLM_BASE_URL: el backend corre EN DOCKER → localhost sería el propio
# container. Usar el alias de red del proxy (ESC-11):
LITELLM_BASE_URL=http://luana_litellm_dev:4000/v1
# MISMO valor que deploy/litellm/.env::LITELLM_MASTER_KEY:
LITELLM_MASTER_KEY=sk-REPLACE_ME_igual_que_proxy
# OPENAI_API_KEY: solo consumidores fuera del proxy (si aplica). El chat/embedding
# normal NO la usa — va por el proxy.
OPENAI_API_KEY=sk-REPLACE_ME

# === LLM role routing (Chinese-first cement 2026-06-04) ===
# {provider}/{model} DEBE igualar un model_name de deploy/litellm/config.dev.yaml.
# Sin estos, el código cae a defaults openai/gpt-4o* que el proxy NO declara.
AI_PROVIDER_NANO=deepseek
AI_MODEL_NANO=deepseek-v4-flash
AI_PROVIDER_FAST=deepseek
AI_MODEL_FAST=deepseek-v4-flash
AI_PROVIDER_REASONING=deepseek
AI_MODEL_REASONING=deepseek-reasoner
AI_PROVIDER_AGENT=kimi
AI_MODEL_AGENT=kimi-k2
AI_PROVIDER_VISION=kimi
AI_MODEL_VISION=kimi-k2
AI_PROVIDER_EMBEDDING=openai
AI_MODEL_EMBEDDING=text-embedding-3-large

