# vitalia/.env.dev.template
# CHECKED IN — copialo a vitalia/.env.dev (gitignored) y rellena valores reales.
# vitalia/.env.dev NUNCA debe commitearse (.gitignore ya lo excluye).
#
# S-DOCKER-DEV-MULTIBRAND T-7 — 2026-05-15

# === Clerk (Auth) ===
# Pega valores desde Clerk dashboard → API Keys. Frontend API URL == CLERK_ISSUER.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
# CLERK_ISSUER = Frontend API URL — requerido por core/luana-core-iam/application/auth.py (JWT verify)
CLERK_ISSUER=https://REPLACE_ME.clerk.accounts.dev
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# === Database ===
# Host: usar 127.0.0.1 cuando conectas desde el host
# Container: usar luana_postgres_dev cuando conectas desde otro container
DATABASE_URL=postgresql+asyncpg://postgres:password@127.0.0.1:5435/vitalia_dev

# === Redis (DB 1) ===
REDIS_URL=redis://127.0.0.1:6379/1

# === Qdrant ===
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_COLLECTION_PREFIX=vitalia_

# === Brand ===
BRAND_SLUG=vitalia
ENVIRONMENT=development

# === LLM ===
OPENAI_API_KEY=sk-REPLACE_ME
LITELLM_PROXY_URL=http://localhost:4000

# === Brand-specific config (engine consume desde aquí — proposal 2026-05-19) ===
# Post purge nicolify defaults en core/luana-core-platform/core/config.py:
# engine defaults son "" — brand DEBE override aquí (failfast vs silent contamination).
# Si no se setean, código que consume estos settings raisea ConfigError o produce URLs vacías.
FRONTEND_URL=https://dev-app.vitalialat.com
COPILOT_TELEGRAM_BOT_USERNAME=vitalia_copilot_bot
QDRANT_COLLECTION=vitalia_knowledge
QDRANT_COLLECTION_HYBRID=vitalia_hybrid
LITELLM_BASE_URL=http://localhost:4000/v1

# === Cloudflared (solo si usas make dev-vitalia-tunnel) ===
# Locally-managed tunnel — el cloudflared container usa
# vitalia/deploy/cloudflared/{dev-config.yml, .credentials/dev-tunnel.json}.
# NO se usa TUNNEL_TOKEN aqui (eso es remotely-managed, mutuamente excluyente).
# Dominio dev: dev-app.vitalialat.com (zona unica en cuenta CF vitalia).

# === Next.js / Frontend ===
# LOCAL access (puerto 3002 directo): NEXT_PUBLIC_API_URL apunta a backend localhost.
# TUNNEL access (dev-app.vitalialat.com): descomentar bloque tunnel + comentar local.
NEXT_PUBLIC_API_URL=http://localhost:8002
# NEXT_PUBLIC_APP_URL=https://dev-app.vitalialat.com
# NEXT_PUBLIC_API_URL=https://dev-app.vitalialat.com
INTERNAL_API_URL=http://vitalia_backend_dev:8002
# CLERK_DOMAIN=dev-app.vitalialat.com

# === PHI Encryption (pgcrypto KEK) ===
# DEV-ONLY · NO usar en prod · prod=KMS (ADR-vitalia-007)
# Generar con: python3 -c "import secrets; print(secrets.token_hex(32))"
VITALIA_PHI_KEK=REPLACE_ME_run_python3_secrets_token_hex_32

# === Admin Streamlit (T-5 vitalia-auth-base-functional) ===
# VITALIA_ADMIN_PASSWORD: password en texto plano — SOLO para dev local.
# NUNCA usar un password real aqui. Para produccion, generar hash con:
#   bash vitalia/deploy/scripts/generate_admin_password_hash.sh
VITALIA_ADMIN_PASSWORD=dev_admin_REPLACE_ME
# VITALIA_ADMIN_PASSWORD_HASH: bcrypt hash del password de admin.
# Generar con: bash vitalia/deploy/scripts/generate_admin_password_hash.sh
# Pegar el hash resultado (ej: $2b$12$xxx...) abajo para dev local:
VITALIA_ADMIN_PASSWORD_HASH=REPLACE_ME_run_generate_admin_password_hash_sh
# VITALIA_CLERK_WEBHOOK_SECRET: requerido para validar webhooks Clerk en BE (T-4).
# Obtener desde: Clerk Dashboard → Webhooks → endpoint → Signing Secret
VITALIA_CLERK_WEBHOOK_SECRET=whsec_REPLACE_ME

# === Admin Internal API Token ===
# VITALIA_INTERNAL_API_TOKEN: token para validar llamadas internas entre
# el admin Streamlit (puerto 8502) y el FastAPI backend (puerto 8002).
# Generar con: openssl rand -hex 32
#
# IMPORTANTE — valores con $, ! o espacios DEBEN usar comillas simples:
#   VITALIA_INTERNAL_API_TOKEN='abc123!secret$value'  # correcto con caracteres especiales
#   VITALIA_INTERNAL_API_TOKEN=abc123simple           # correcto si no hay caracteres especiales
#
VITALIA_INTERNAL_API_TOKEN='REPLACE_ME_openssl_rand_hex_32'

# === Ports (referencia — definidos en compose file) ===
# Backend: 8002
# Frontend: 3002
# Admin Streamlit: 8502
