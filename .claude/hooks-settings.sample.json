{
  "_comment": "Sample hooks config para mecanismos A (SessionStart sync) + L (PreToolUse pre-push). Merge a ~/.claude/settings.json manualmente. SSoT: docs/process/parallel-sessions-protocol.md § D10 + D14.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/scripts/git/check-sync.sh 2>/dev/null || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[[ \"$CLAUDE_TOOL_INPUT\" =~ git\\ push\\ origin\\ (wip|hotfix|exp)/ ]] && bash $CLAUDE_PROJECT_DIR/scripts/git/push-wip.sh --check-only 2>/dev/null; true"
          }
        ]
      }
    ]
  }
}
