{
  "permissions": {
    "deny": [
      "Bash(rm -rf /)",
      "Bash(git push --force origin main)",
      "Read(frontend/node_modules/**)",
      "Read(**/__pycache__/**)",
      "Read(frontend/.next/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/auto-chain-detect.sh",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/learning-detect.sh",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/claude-md-overlay-check.sh",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/contract-guard.js",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.venv/bin/python ${CLAUDE_PROJECT_DIR}/scripts/validate_session_close.py --quiet",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "github@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": false,
    "harness@prenter-marketplace": true
  },
  "extraKnownMarketplaces": {
    "prenter-marketplace": {
      "source": {
        "source": "github",
        "repo": "alpacapurpura/prenter-marketplace"
      }
    }
  }
}
