# deploy/litellm/.env.example — TRACKED (sin valores reales).
# Copialo a deploy/litellm/.env (gitignored) y rellena. El proxy LiteLLM
# (scripts/litellm-proxy-up.sh · make litellm-up) lee ese env file.
#
# El backend NUNCA ve estas keys — solo habla con el proxy usando
# LITELLM_MASTER_KEY (vitalia/.env.dev debe tener el MISMO valor).
#
# Política Chinese-first (cement 2026-06-04): DeepSeek + Kimi son la base;
# OpenAI = excepción (embeddings + raro high-need chat).

# DeepSeek — https://platform.deepseek.com → API Keys
DEEPSEEK_API_KEY=sk-REPLACE_ME

# Moonshot (Kimi) — https://platform.moonshot.ai → API Keys
MOONSHOT_API_KEY=sk-REPLACE_ME

# OpenAI (solo embeddings + gpt-4o-mini excepción) — https://platform.openai.com
OPENAI_API_KEY=sk-REPLACE_ME

# Master key del proxy — inventala (openssl rand -hex 32). El backend la usa
# como api_key hacia el proxy: MISMO valor en vitalia/.env.dev::LITELLM_MASTER_KEY.
LITELLM_MASTER_KEY=sk-REPLACE_ME_openssl_rand_hex_32
